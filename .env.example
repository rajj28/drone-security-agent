# Google Gemini (primary VLM / LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Production: Flash first avoids ~30s of Pro 429 retries per call
GEMINI_PREFER_FLASH=true
API_MIN_INTERVAL_SEC=12
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_EMBEDDING_DIMENSION=768

# Pinecone — flytbase index (llama-text-embed-v2, 768 dim, integrated inference)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=flytbase
PINECONE_DIMENSION=768
PINECONE_USE_INTEGRATED=true
PINECONE_NAMESPACE=drone-security
PINECONE_TEXT_FIELD=text
# Optional: skip describe-index lookup
# PINECONE_HOST=https://flytbase-xxxx.svc.aped-4627-b74a.pinecone.io

# Hugging Face (cloud CLIP + BLIP — optional if using standard Gemini-only vision)
HF_API_TOKEN=your_huggingface_token_here
USE_CLOUD_ANALYZER=true
GPT_SINGLE_STAGE=true
SKIP_HF_APIS=false

# Session — one video per SESSION_ID (also used as Pinecone namespace when set)
SESSION_ID=theft_newsflare_001
MAX_FRAMES=20
USE_MONGO_CONTEXT=false

# API pacing
API_MIN_INTERVAL_SEC=10

# LangChain (optional tracing)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=drone-security-agent

# MongoDB (optional production)
# MONGODB_URI=
